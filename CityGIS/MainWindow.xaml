<Window x:Class="CityGIS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ht="http://helix-toolkit.org/wpf"
        Title="City GIS 3D Viewer" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Panel -->
        <Border Grid.Row="0" Background="#333333" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="City GIS 3D Viewer" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CityNameBlock" Foreground="White" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="ResetCameraButton" Content="Reset Camera" Click="ResetCamera_Click" Margin="20,0,0,0" Padding="10,5"/>
                <Button x:Name="InfoButton" Content="Show Info" Click="ShowInfo_Click" Margin="10,0,0,0" Padding="10,5"/>
                <CheckBox x:Name="ShowNamesCheckBox" Content="Show Names" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0" Checked="ShowNames_Changed" Unchecked="ShowNames_Changed"/>
            </StackPanel>
        </Border>

        <!-- 3D Viewport -->
        <ht:HelixViewport3D x:Name="CityViewport" 
                           Grid.Row="1"
                           ZoomExtentsWhenLoaded="True"
                           ShowCoordinateSystem="True">
            <ht:HelixViewport3D.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="CornflowerBlue" Offset="0"/>
                    <GradientStop Color="LightBlue" Offset="1"/>
                </LinearGradientBrush>
            </ht:HelixViewport3D.Background>
            <ht:DefaultLights/>
        </ht:HelixViewport3D>

        <!-- Building Details Panel -->
        <Border x:Name="DetailsPanel" Grid.Row="2" Background="#222222" Padding="12" Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Building Details" Foreground="Gold" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="X" Click="CloseDetails_Click" Margin="15,0,0,0" Padding="6,2" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name:" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Grid.Column="0"/>
                    <TextBlock x:Name="DetailName" Foreground="White" FontSize="12" VerticalAlignment="Center" Grid.Column="2"/>
                    <TextBlock Text="Type:" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Grid.Column="4"/>
                    <TextBlock x:Name="DetailType" Foreground="White" FontSize="12" VerticalAlignment="Center" Grid.Column="6"/>
                    <TextBlock Text="Size:" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Grid.Column="8"/>
                    <TextBlock x:Name="DetailSize" Foreground="White" FontSize="12" VerticalAlignment="Center" Grid.Column="10"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Position:" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Grid.Column="0"/>
                    <TextBlock x:Name="DetailPosition" Foreground="White" FontSize="12" VerticalAlignment="Center" Grid.Column="2"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#333333">
            <StatusBarItem>
                <TextBlock x:Name="StatusBlock" Text="Loading city data..." Foreground="White"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatsBlock" Text="Buildings: 0 | Roads: 0" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
